# ThaiLLM Playground key — server-only. Never prefix with PUBLIC_.
# Absent key => the app runs in composer mode with no LLM calls at all.
THAILLM_API_KEY=

# 'auto' (default) | 'composer' (never call the LLM) | 'llm-only' (QA: no bank fallback)
ORACLE_MODE=auto

# Primary model. Measured most reliable: openthaigpt (8/8, p50 1.8s).
ORACLE_MODEL=openthaigpt
